@page "/groups"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<div class="controls">
    <div>
        <h1>Группы</h1>

        <div>
            <a href="groups/create" class="btn btn-primary">Добавить</a>
        </div>
    </div>

    <div>
        <label for="items-per-pages">Элементов на странице:</label>
        <select id="items-per-pages" @bind="pagination.ItemsPerPage" class="form-control">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="13">13</option>
        </select>
    </div>
</div>

<hr />
<div class="search-panel">
    <form action="/groups" data-enhance data-permanent>
        <input type="search" name="groupNameFilter" />
        <input type="submit" value="Search" />
    </form>
</div>
<hr />

<div>
    <div class="grid-container">
        <QuickGrid Class="table" Items="FilteredGroups.Include(g => g.Direction)" Pagination="pagination">
            <PropertyColumn Class="group-name" Property="group => group.group_name" Sortable="true" />
            <PropertyColumn Class="direction-name" Property="group => group.Direction.direction_name" Sortable="true" />
            <PropertyColumn Class="start-time" Property="group => group.start_time" Sortable="true" />
            <PropertyColumn Class="learning-days"
                            Property="group => new Week((int)(group.learning_days ?? 0))"
                            Sortable="true" />
            <PropertyColumn Class="start-date" Property="group => group.start_date" Sortable="true" />

            <TemplateColumn Context="group">
                <a href="@($"groups/details?group_id={group.group_id}")">Details</a>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <Paginator State="pagination"></Paginator>
</div>

@code {
    private AcademyContext context = default!;

    GridSort<Group> sortBy = GridSort<Group>.ByAscending(m => m.group_name);

    PaginationState pagination = new PaginationState { ItemsPerPage = 3 };

    [SupplyParameterFromQuery]
    private string? groupNameFilter { get; set; }

    private IQueryable<Group> FilteredGroups =>
        context.Groups.Where(g => g.group_name!.Contains(groupNameFilter ?? string.Empty));

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
