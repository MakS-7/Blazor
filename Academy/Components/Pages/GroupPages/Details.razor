@page "/groups/details"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div>
    @* <h2>Group</h2>
    <hr /> *@
    
    @if (group is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="controls">
            <h1>@group.group_name</h1>
            <a href="@($"/groups/edit?group_id={group.group_id}")" class="btn btn-primary ">Edit</a>
        </div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">group_name</dt>
            <dd class="col-sm-10">@group.group_name</dd>
            <dt class="col-sm-2">direction</dt>
            <dd class="col-sm-10">@group.direction</dd>
            <dt class="col-sm-2">learning_days</dt>
            <dd class="col-sm-10">@(new Week((int)(group.learning_days ?? 0)))</dd>
            <dt class="col-sm-2">start_time</dt>
            <dd class="col-sm-10">@group.start_time</dd>
            <dt class="col-sm-2">start_date</dt>
            <dd class="col-sm-10">@group.start_date</dd>
        </dl>
        <QuickGrid Class="table" Items="FiltredStudents">
            <TemplateColumn Class="full-name" Context="student" Title="Студент">
                <a href="@($"students/details?stud_id={student.stud_id}")">@student.full_name</a>
            </TemplateColumn>
            <PropertyColumn Class="birth-date" Property="student => student.birth_date" />
        </QuickGrid>
        <div>
            <a href="@($"/groups")">Back to List</a>
        </div>
    }
</div>

@code {
    private AcademyContext context = default!;

    private Group? group;

    [SupplyParameterFromQuery]
    private int group_id { get; set; }

    private IQueryable<Student> FiltredStudents =>
        context.Students.Where(s => s.Group.group_name!.Contains(group.group_name ?? string.Empty));

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        group = await context.Groups.FirstOrDefaultAsync(m => m.group_id == group_id);

        if (group is null)
        {
            NavigationManager.NotFound();
        }
    }
}
