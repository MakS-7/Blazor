@page "/directions/details"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1> *@

<div>
    @* <h2>Direction</h2>
    <hr /> *@
    @if (direction is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <h1>@direction.direction_name</h1>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Количество групп</dt>
            <dd class="col-sm-10">@direction.Groups.Count</dd>
            <dt class="col-sm-2">Количество студентов</dt>
            <dd class="col-sm-10">@studentsCount</dd>
        </dl>
        <QuickGrid Class="table" Items="FiltredGroups">
            <PropertyColumn Class="group-name" Title="Группы" Property="group => group.group_name" Sortable="true"/>
            <PropertyColumn Title="Студентов в группе" Property="group => group.Students.Count" Sortable="true"/>
        </QuickGrid>
        <div>
            <a href="@($"/directions/edit?direction_id={direction.direction_id}")">Edit</a> |
            <a href="@($"/directions")">Back to List</a>
        </div>
    }
</div>

@code {
    private AcademyContext context = default!;

    private Direction? direction;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    int studentsCount = 0;

    private IQueryable<Group> FiltredGroups =>
        context.Groups.Where(g => g.Direction.direction_name!.Contains(direction.direction_name ?? string.Empty));

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        direction = await context.Directions.Include(d => d.Groups).ThenInclude(g => g.Students).FirstOrDefaultAsync(m => m.direction_id == direction_id);

        foreach (Group group in direction.Groups) studentsCount += group.Students.Count();

        if (direction is null)
        {
            NavigationManager.NotFound();
        }
    }
}
