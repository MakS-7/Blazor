@page "/dec2hex"
@rendermode InteractiveServer

<h3>Dec → Hex</h3>

<div class="converter">
    <label for="dec-input" class="form-label">Десятичное число:</label>
    <input id="dec-input" type="text" class="form-control"
           @bind="decimalInput"
           @bind:after="Convert"
           placeholder="Введите целое число (напр. 255)" />

    @if (_error != null)
    {
        <div class="text-danger mt-2">@_error</div>
    }

    <div class="mt-3">
        <strong>Результат (шестнадцатеричное):</strong>
        <span class="result">@(_result ?? "—")</span>
    </div>
</div>

@code {
    private string decimalInput = "";
    private string? _result;
    private string? _error;

    protected override void OnInitialized() => Convert();

    private void Convert()
    {
        _error = null;
        _result = null;

        if (string.IsNullOrWhiteSpace(decimalInput))
            return;

        if (!int.TryParse(decimalInput, out int value))
        {
            _error = "Введите целое число в десятичной системе.";
            return;
        }

        _result = value.ToString("X");
    }
}
