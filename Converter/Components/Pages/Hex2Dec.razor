@page "/hex2dec"
@rendermode InteractiveServer

<h3>Hex → Dec</h3>

<div class="converter">
    <label for="hex-input" class="form-label">Шестнадцатеричное число:</label>
    <input id="hex-input" type="text" class="form-control"
           @bind="hexInput"
           @bind:after="Convert"
           placeholder="Введите hex-число (напр. FF, 1A3B)" />

    @if (_error != null)
    {
        <div class="text-danger mt-2">@_error</div>
    }

    <div class="mt-3">
        <strong>Результат (десятичное):</strong>
        <span class="result">@(_result ?? "—")</span>
    </div>
</div>

@code {
    private string hexInput = "";
    private string? _result;
    private string? _error;

    protected override void OnInitialized() => Convert();

    private void Convert()
    {
        _error = null;
        _result = null;

        if (string.IsNullOrWhiteSpace(hexInput))
            return;

        // Убираем опциональный префикс 0x / 0X
        string cleaned = hexInput.Trim();
        if (cleaned.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
            cleaned = cleaned[2..];

        // Проверяем допустимые символы
        if (!cleaned.All(c => Uri.IsHexDigit(c)))
        {
            _error = "Шестнадцатеричное число может содержать только 0-9, A-F.";
            return;
        }

        try
        {
            long value = System.Convert.ToInt64(cleaned, 16);
            _result = value.ToString();
        }
        catch (OverflowException)
        {
            _error = "Число слишком большое. Допустимый диапазон: 16 hex-символов (64 бита).";
        }
    }
}
