@page "/bin2dec"
@rendermode InteractiveServer

@using System

<h3>Bin → Dec</h3>

<div class="converter">
    <label for="bin-input" class="form-label">Двоичное число:</label>
    <input id="bin-input" type="text" class="form-control"
           @bind="binaryInput"
           @bind:after="Convert"
           placeholder="Введите двоичное число (напр. 11111111)" />

    @if (_error != null)
    {
        <div class="text-danger mt-2">@_error</div>
    }

    <div class="mt-3">
        <strong>Результат (десятичное):</strong>
        <span class="result">@(_result ?? "—")</span>
    </div>
</div>

@code {
    private string binaryInput = "";
    private string? _result;
    private string? _error;

    protected override void OnInitialized() => Convert();

    private void Convert()
    {
        _error = null;
        _result = null;

        if (string.IsNullOrWhiteSpace(binaryInput))
            return;

        // Проверяем, что ввод содержит только 0 и 1
        if (!binaryInput.All(c => c is '0' or '1'))
        {
            _error = "Двоичное число может содержать только символы 0 и 1.";
            return;
        }

        try
        {
            long value = System.Convert.ToInt64(binaryInput, 2);
            _result = value.ToString();
        }
        catch (OverflowException)
        {
            _error = "Число слишком большое. Допустимый диапазон: 64 бита.";
        }
    }
}
