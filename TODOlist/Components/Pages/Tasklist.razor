@page "/tasklist"
@rendermode InteractiveServer

<div class="controls">
    <input type="text" placeholder="Новая задача" class="form-control" @bind="description"/>
    <burron class="btn btn-primary" @onclick="AddTusk">Добавить</burron>
</div>
<hr />

<h3>Tasklist</h3>

<div class="statistics">
    <h5>Всего: @tasklist.Count </h5>
    <h5>Выполнено: @tasklist.Where(t => t.DONE == true).ToList().Count</h5>
    <h5>Осталось: @tasklist.Where(t => t.DONE == false).ToList().Count</h5>
</div>

<div>
    <button class="btn btn-danger" @onclick="DeleteDoneTask">Удалить выполненные</button>
    <button class="btn btn-danger" @onclick="() => tasklist.Clear()">Очистить список</button>
</div>

<hr />

<ul>
    @foreach (TODO task in tasklist)
    {
        <li>
            <input type="checkbox" id="@task.Description" @bind="task.DONE"/>
            <label for="@task.Description">@task.Description    | @task.CreateTime</label>
            <button class="btn btn-danger" @onclick="() => DeleteTask(task)">Удалить задачу</button>
        </li>
    }
</ul>

@code {
    //List<TODO> tasklist = [];
    List<TODO> tasklist = [ 
        new TODO {Description = "Полить цветы", CreateTime = DateTime.Now},
        new TODO {Description = "Покормить кота", CreateTime = DateTime.Now},
        new TODO {Description = "Помыть посуду", CreateTime = DateTime.Now}
    ];
    private string? description;
    private void AddTusk()
    {
        if (string.IsNullOrWhiteSpace(description)) return;
        if (tasklist.Contains(new TODO { Description = description })) return;
        tasklist.Add(new TODO { Description = description, CreateTime = DateTime.Now});
        description = "";
    }

    private void DeleteTask(TODO task)
    {
        tasklist.Remove(task);
    }

    private void DeleteDoneTask()
    {
        for (int i = tasklist.Count - 1; i >= 0; i--)
        {
            if(tasklist[i].DONE == true)
            {
                tasklist.RemoveAt(i);
            }
        }
    }
}
